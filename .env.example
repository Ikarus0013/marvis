# Copy this file to .env and replace each placeholder with your value.

# Signing secret of your Slack app (Slack app settings > Basic Information > App Credentials).
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Anthropic API key (https://console.anthropic.com/). Starts with "sk-ant-".
ANTHROPIC_API_KEY=your-anthropic-api-key

# Zapier "Catch Hook" URL that gets the LinkedIn requests.
ZAPIER_LINKEDIN_WEBHOOK=https://hooks.zapier.com/hooks/catch/000000/linkedin/

# Zapier "Catch Hook" URL that gets the blog requests.
ZAPIER_BLOG_WEBHOOK=https://hooks.zapier.com/hooks/catch/000000/blog/

# Optional. Claude model for the routing call. The model must accept a forced tool choice.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. TCP port for the HTTP server. Default is 3000.
PORT=3000
